#!/usr/bin/env bb
;; Minimal MCP (stdio) server exposing Godspeed to Claude Desktop.
;; stdout is reserved for JSON-RPC; never println anything else.

(ns gs-mcp
  (:require [babashka.classpath :as cp]
            [cheshire.core :as json]
            [clojure.java.io :as io]
            [clojure.string :as str]))

;; Shared code lives in godspeed.clj next to this script (resolving symlinks).
(cp/add-classpath (str (.getParentFile (.getCanonicalFile (io/file *file*)))))
(require '[godspeed :as g :refer [api fetch-tasks fetch-lists fetch-labels due-date start-date
                                  today-task? resolve-list-id]])

(defn lookup-list-id [name]
  (or (resolve-list-id name (fetch-lists))
      (throw (ex-info (str "List not found: " name) {}))))

(defn task->map
  "Task as returned to the MCP client. Nil fields are dropped to keep results small."
  [t lists labels notes?]
  (let [label-name (fn [id] (some #(when (= (:id %) id) (:name %)) labels))]
    (into {}
          (remove (fn [[_ v]] (or (nil? v) (= v "") (= v []))))
          {:id (:id t)
           :title (:title t)
           :list (some #(when (= (:id %) (:list_id t)) (:name %)) lists)
           :labels (vec (keep label-name (:label_ids t)))
           :due (due-date t)
           :start (start-date t)
           :indent_level (:indent_level t)
           :notes (when notes? (:notes t))
           :created_at (:created_at t)
           :updated_at (:updated_at t)
           :completed_at (:completed_at t)})))

;; --- Tools ---
(def tools
  [{:name "list_lists"
    :description "List Godspeed lists in app order, with the folder each belongs to. Includes folders (type \"folder\", e.g. 'Someday/Maybe'), which group lists but cannot hold tasks themselves; use the lists inside them. Smart lists are omitted (they cannot be queried). Archived lists have archived=true. Names may start with an emoji; list arguments elsewhere match with or without it."
    :inputSchema {:type "object" :properties {}}
    :handler (fn [_]
               (->> (g/lists-with-folders (fetch-lists))
                    (map (fn [l]
                           (cond-> {:id (:id l) :name (:name l) :type (:list_type l)}
                             (:folder l) (assoc :folder (:folder l))
                             (:archived_at l) (assoc :archived true))))))}
   {:name "list_tasks"
    :description "List tasks, sorted by order. indent_level shows subtask nesting. Each task includes labels (names), notes, due/start dates, created_at/updated_at (for staleness) and completed_at (for status=complete, e.g. 'done this week'). Max 250 tasks."
    :inputSchema {:type "object"
                  :properties {:list {:type "string" :description "List name (optional)"}
                               :status {:type "string" :enum ["incomplete" "complete"]}
                               :label {:type "string" :description "Only tasks carrying this label name (optional)"}
                               :include_notes {:type "boolean" :description "Include task notes (default true; set false for a compact result)"}}}
    :handler (fn [{:keys [list status label include_notes]}]
               (let [lists (fetch-lists)
                     labels (fetch-labels)
                     list-id (when list (or (resolve-list-id list lists)
                                            (throw (ex-info (str "List not found: " list) {}))))
                     label-id (when label (or (g/find-by-name label labels)
                                              (throw (ex-info (str "Label not found: " label) {}))))]
                 (->> (fetch-tasks :status status :list-id list-id)
                      (filter #(or (nil? label-id) (some #{label-id} (:label_ids %))))
                      (sort-by :order_index)
                      (map #(task->map % lists labels (not (false? include_notes)))))))}
   {:name "today_tasks"
    :description "Tasks that are actionable now (mirrors the 'My today' smart list): labelled wip, due today or overdue, or start date reached. Sorted by due date. Same fields as list_tasks."
    :inputSchema {:type "object" :properties {}}
    :handler (fn [_]
               (let [lists (fetch-lists)
                     labels (fetch-labels)]
                 (->> (g/today-tasks (fetch-tasks) labels)
                      (map #(task->map % lists labels true)))))}
   {:name "list_labels"
    :description "List label names usable with add_task and the list_tasks label filter."
    :inputSchema {:type "object" :properties {}}
    :handler (fn [_] (map :name (fetch-labels)))}
   {:name "add_task"
    :description "Create a task."
    :inputSchema {:type "object"
                  :properties {:title {:type "string"}
                               :list {:type "string" :description "List name (default: inbox)"}
                               :due {:type "string" :description "YYYY-MM-DD"}
                               :notes {:type "string"}
                               :labels {:type "string" :description "Comma-separated label names (see list_labels)"}}
                  :required ["title"]}
    :handler (fn [{:keys [title list due notes labels]}]
               (when (and due (not (g/valid-date? due)))
                 (throw (ex-info "due must be a valid YYYY-MM-DD date" {})))
               (api :post "/tasks"
                    :body (cond-> {:title title}
                            list (assoc :list_id (lookup-list-id list))
                            due (assoc :timeless_due_at due)
                            notes (assoc :notes notes)
                            labels (assoc :label_ids (g/resolve-label-ids labels (fetch-labels)))))
               (str "Created: " title))}
   {:name "complete_task"
    :description "Mark a task complete by id (get ids from list_tasks)."
    :inputSchema {:type "object" :properties {:id {:type "string"}} :required ["id"]}
    :handler (fn [{:keys [id]}]
               (api :patch (str "/tasks/" id) :body {:is_complete true})
               (str "Completed: " id))}
   {:name "delete_task"
    :description "Permanently delete a task by id (get ids from list_tasks)."
    :inputSchema {:type "object" :properties {:id {:type "string"}} :required ["id"]}
    :handler (fn [{:keys [id]}]
               (api :delete (str "/tasks/" id))
               (str "Deleted: " id))}])

(def tools-by-name (into {} (map (juxt :name identity) tools)))

(defn call-tool [{:keys [name arguments]}]
  (if-let [{:keys [handler]} (tools-by-name name)]
    (try
      (let [r (handler arguments)]
        {:content [{:type "text" :text (if (string? r) r (json/generate-string r))}]})
      (catch Exception e
        {:isError true :content [{:type "text" :text (str "Error: " (ex-message e))}]}))
    {:isError true :content [{:type "text" :text (str "Unknown tool: " name)}]}))

;; --- JSON-RPC ---
(defn respond [id result]
  (println (json/generate-string {:jsonrpc "2.0" :id id :result result}))
  (flush))

(defn respond-error [id code msg]
  (println (json/generate-string {:jsonrpc "2.0" :id id :error {:code code :message msg}}))
  (flush))

(defn handle [{:keys [id method params]}]
  (case method
    "initialize" (respond id {:protocolVersion (or (:protocolVersion params) "2024-11-05")
                              :capabilities {:tools {}}
                              :serverInfo {:name "godspeed" :version "0.1.0"}})
    "tools/list" (respond id {:tools (map #(dissoc % :handler) tools)})
    "tools/call" (respond id (call-tool params))
    "ping"       (respond id {})
    ;; notifications (no id) get no reply; unknown requests get an error
    (when id (respond-error id -32601 (str "Method not found: " method)))))

(when-not (g/api-key)
  (binding [*out* *err*] (println "GODSPEED_API_KEY not set"))
  (System/exit 1))

(doseq [line (line-seq (java.io.BufferedReader. *in*))
        :when (not (str/blank? line))]
  (try
    (let [msg (try (json/parse-string line true)
                   (catch Exception _ ::parse-error))]
      (if (= msg ::parse-error)
        (respond-error nil -32700 "Parse error")
        (try (handle msg)
             (catch Exception e
               (when (:id msg) (respond-error (:id msg) -32603 (str "Internal error: " (ex-message e))))))))
    (catch Throwable t
      (binding [*out* *err*] (println "gs-mcp: unexpected error:" (ex-message t))))))
